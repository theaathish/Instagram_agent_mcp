{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mcp.ts": { "maxDuration": 60 },
    "api/rest/[...path].ts": { "maxDuration": 60 },
    "api/rest/insights.ts": { "maxDuration": 60 },
    "api/oauth/[action].ts": { "maxDuration": 60 },
    "api/admin/accounts.ts": { "maxDuration": 60 },
    "api/admin/oauth/[action].ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/cron/refresh", "schedule": "0 8 */30 * *" }],
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/wellknown/resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/wellknown/authserver" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/api/openapi.json", "destination": "/api/openapi" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
