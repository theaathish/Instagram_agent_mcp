# Copy to .env (local only, never commit) or set via `vercel env add`.
# Production values are set in the Vercel dashboard (or `vercel env add ... production`).

# --- secrets (required) ---
ADMIN_PASSWORD=
IG_USER_ID=
# IG_LONG_LIVED_TOKEN=        # optional one-time seed (or use /api/admin/seed-token)
# BRAND_STYLE=                # optional, e.g. "warm minimal lifestyle photography"
# HF_TOKEN=                   # optional: use Hugging Face instead of Pollinations for image gen
OAUTH_JWT_SECRET=             # random 32+ chars: openssl rand -hex 32

# --- Vercel integrations (auto-set when you add Storage in the dashboard) ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=

# --- cron (Vercel sends this automatically when CRON_SECRET is set) ---
# CRON_SECRET=

# --- plain env ---
IG_API_VERSION=v26.0
IG_GRAPH_BASE=https://graph.instagram.com
PUBLIC_IMAGE_BASE_URL=
